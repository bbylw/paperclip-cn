---
import Section from './Section.astro';
import {
  quickstartSnippets,
  requirements,
  npmRegistryTip,
  devResources,
} from '../data/quickstart';
import { links } from '../data/site';
import CodeBlock from './CodeBlock.astro';
import Icon from './Icon.astro';

/*
 * 原来 6 个代码块 2×3 平铺，同排卡片高度差最大 148px，网格底边参差；
 * 「一键安装（推荐）」的「推荐」也没有任何视觉标记。
 *
 * 现在：主路径占满整行并带「推荐」chip，4 条备选 2×2，
 * 第 6 条（绑定模式）与环境要求、排障并排放进底部三列 —— 所有格子都填满。
 */
const [primary, nonInteractive, quickTry, testDrive, source, bind] = quickstartSnippets;
const secondary = [nonInteractive, quickTry, testDrive, source];
---

<Section
  id="quickstart"
  eyebrow="QUICKSTART"
  title="快速开始"
  lead="开源。自托管。无需 Paperclip 账号。"
>
  <div data-reveal>
    <CodeBlock code={primary.code} title={primary.title} note={primary.note} badge="推荐" />
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    {
      secondary.map((snippet, i) => (
        <div class="min-w-0" data-reveal style={`--reveal-delay:${(i % 2) * 60}ms`}>
          <CodeBlock code={snippet.code} title={snippet.title} note={snippet.note} />
        </div>
      ))
    }
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <div class="card p-6" data-reveal>
      <div class="flex items-center gap-2.5">
        <span
          class="grid size-8 shrink-0 place-items-center rounded-lg bg-ink-850 text-ink-300 ring-1 ring-ink-700"
        >
          <Icon name="terminal" class="size-4" />
        </span>
        <h3 class="text-base font-medium text-ink-100">环境要求</h3>
      </div>
      <dl class="mt-5 space-y-2.5">
        {
          requirements.map((req) => (
            <div class="flex items-baseline justify-between gap-3 border-b border-ink-800 pb-2.5 last:border-0">
              <dt class="shrink-0 text-sm text-ink-400">{req.label}</dt>
              <dd class="text-right font-mono text-xs text-ink-200">{req.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="min-w-0" data-reveal style="--reveal-delay:60ms">
      <CodeBlock code={bind.code} title={bind.title} note={bind.note} />
    </div>

    <aside class="card p-6" data-reveal style="--reveal-delay:120ms">
      <div class="flex items-center gap-2.5">
        <span
          class="grid size-8 shrink-0 place-items-center rounded-lg bg-brand-500/12 text-brand-300 ring-1 ring-brand-500/30"
        >
          <Icon name="shield" class="size-4" />
        </span>
        <h3 class="text-base font-medium text-ink-100">排障：私有 npm 源</h3>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-ink-400">
        <span class="text-ink-200">{npmRegistryTip.problem}</span>
        {npmRegistryTip.cause}
      </p>
      <div class="mt-4 space-y-2 font-mono text-xs">
        <p class="rounded-lg bg-ink-950/70 px-3 py-2 leading-relaxed">
          <span class="text-ink-400"># 诊断</span>
          <br />
          <span class="text-ink-100">{npmRegistryTip.diagnose}</span>
        </p>
        <p class="rounded-lg bg-ink-950/70 px-3 py-2 leading-relaxed break-all text-mint-300">
          {npmRegistryTip.fix}
        </p>
      </div>
    </aside>
  </div>

  <nav aria-label="上游文档" class="mt-4 grid gap-3 sm:grid-cols-3" data-reveal>
    {
      devResources.map((item) => (
        <a
          href={item.href}
          target="_blank"
          rel="noreferrer noopener"
          class="card card-hover group flex items-center gap-3 px-4 py-3.5"
        >
          <span
            class="grid size-8 shrink-0 place-items-center rounded-lg bg-ink-850 font-mono text-[10px] text-ink-400 ring-1 ring-ink-700"
          >
            MD
          </span>
          <span class="min-w-0 flex-1">
            <span class="block font-mono text-xs text-ink-100">{item.label}</span>
            <span class="block truncate text-xs text-ink-400">{item.hint}</span>
          </span>
          <Icon
            name="arrow"
            class="size-4 shrink-0 text-ink-400 transition group-hover:text-brand-400"
          />
        </a>
      ))
    }
  </nav>

  <p class="mt-6 max-w-3xl text-xs leading-relaxed text-ink-400" data-reveal>
    关于锁定版本、canary 与 git-ref 安装、更新、回滚、服务管理与卸载，详见
    <a href={links.installing} target="_blank" rel="noreferrer noopener" class="link">INSTALLING.md</a
    >。
  </p>
</Section>
