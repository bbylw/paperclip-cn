---
import Section from './Section.astro';
import { faqs } from '../data/faq';
import FaqAccordion from './islands/FaqAccordion';
---

<Section
  id="faq"
  eyebrow="FAQ"
  title="常见问题"
  lead="部署形态、多公司、与其他智能体的区别，以及为什么不用 Asana / Trello。"
>
  <div data-reveal>
    <FaqAccordion client:visible items={faqs} />
  </div>
</Section>
