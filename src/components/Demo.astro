---
import Section from './Section.astro';
import { links } from '../data/site';
import Icon from './Icon.astro';

const community = [
  { label: 'Discord', href: links.discord, hint: '加入社区', icon: 'org' as const },
  { label: 'Twitter / X', href: links.twitter, hint: '关注更新与公告', icon: 'heart' as const },
  { label: 'GitHub Issues', href: links.issues, hint: '缺陷与功能请求', icon: 'ticket' as const },
  { label: 'GitHub Discussions', href: links.discussions, hint: '想法与 RFC', icon: 'book' as const },
  { label: 'awesome-paperclip', href: links.awesome, hint: '发现插件与更多内容', icon: 'plug' as const },
  { label: '贡献指南', href: links.contributing, hint: '我们欢迎贡献', icon: 'check' as const },
];
---

<Section
  id="community"
  title="看它跑起来，然后加入社区"
  lead="Paperclip 面向想把事做成的人——而不是想盯着智能体的人。"
>
  <div class="grid gap-6 lg:grid-cols-[1.35fr_1fr]">
    <figure class="card overflow-hidden" data-reveal>
      {/*
        poster 由 <video poster> 原生加载。之前试过两版更「聪明」的方案都失败：
        动态赋值 video.poster 在 Chromium 不触发重绘；<img loading="lazy">
        垫底会被 <video> 无帧时的不透明黑底完全盖住。19 KB 的封面不值得再耍花招。
      */}
      <video
        controls
        preload="none"
        playsinline
        poster="/images/banner.webp"
        aria-label="Paperclip 演示：智能体团队从目标到产出的完整闭环"
        class="aspect-video w-full bg-ink-950 object-cover"
      >
        <source src={links.demoVideo} type="video/mp4" />
        你的浏览器不支持 video 标签，可以
        <a href={links.demoVideo} target="_blank" rel="noreferrer noopener" class="link"
          >直接观看演示视频</a
        >。
      </video>
      <figcaption
        class="flex items-center gap-2 border-t border-ink-800 px-5 py-3.5 text-xs text-ink-400"
      >
        <Icon name="clock" class="size-3.5 shrink-0" />
        演示：智能体团队从目标到产出的完整闭环
      </figcaption>
    </figure>

    {/*
      社区链接原来是 6 张横排卡片，与四大支柱、Features、文档卡同一家族，
      在页面末尾再撞一次脸。改成方形 tile 网格，图标在上文字在下，
      与「社区」这个区块的轻量感匹配。
    */}
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-2">
      {
        community.map((item, i) => (
          <li data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <a
              href={item.href}
              target="_blank"
              rel="noreferrer noopener"
              class="card card-hover group flex h-full flex-col gap-3 p-4"
            >
              <span class="grid size-9 place-items-center rounded-lg bg-ink-850 text-ink-300 ring-1 ring-ink-700 transition-colors group-hover:text-brand-300">
                <Icon name={item.icon} class="size-4" />
              </span>
              <span class="min-w-0">
                <span class="block truncate text-sm text-ink-100">{item.label}</span>
                <span class="mt-0.5 block text-xs leading-relaxed text-ink-400">{item.hint}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
