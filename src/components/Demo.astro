---
import Section from './Section.astro';
import { links } from '../data/site';
import Icon from './Icon.astro';

const community = [
  { label: 'Discord', href: links.discord, hint: '加入社区', icon: 'org' as const },
  { label: 'Twitter / X', href: links.twitter, hint: '关注更新与公告', icon: 'heart' as const },
  { label: 'GitHub Issues', href: links.issues, hint: '缺陷与功能请求', icon: 'ticket' as const },
  { label: 'GitHub Discussions', href: links.discussions, hint: '想法与 RFC', icon: 'book' as const },
  { label: 'awesome-paperclip', href: links.awesome, hint: '发现插件与更多内容', icon: 'plug' as const },
  { label: '贡献指南', href: links.contributing, hint: '我们欢迎贡献', icon: 'check' as const },
];
---

<Section
  id="community"
  eyebrow="DEMO & COMMUNITY"
  title="看它跑起来，然后加入社区"
  lead="Paperclip 面向想把事做成的人——而不是想盯着智能体的人。"
>
  <div class="grid gap-6 lg:grid-cols-[1.25fr_1fr]">
    <div class="card overflow-hidden p-0" data-reveal>
      {/*
        封面直接用 poster 属性。不用 <img loading="lazy"> 垫底：<video> 在没有帧时
        会绘制不透明黑底，把下层图片完全盖住；动态赋值 video.poster 在 Chromium 上
        又不触发重绘。19 KB 的封面（原本 117 KB）不值得为它引入脆弱技巧。
      */}
      <video
        controls
        preload="none"
        playsinline
        poster="/images/banner.webp"
        aria-label="Paperclip 演示：智能体团队从目标到产出的完整闭环"
        class="aspect-video w-full bg-ink-950 object-cover"
      >
        <source src={links.demoVideo} type="video/mp4" />
        你的浏览器不支持 video 标签，可以
        <a href={links.demoVideo} target="_blank" rel="noreferrer noopener">直接观看演示视频</a>。
      </video>
      <p class="flex items-center gap-2 border-t border-ink-800 px-5 py-3.5 text-xs text-ink-500">
        <Icon name="clock" class="size-3.5" />
        演示：智能体团队从目标到产出的完整闭环
      </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
      {
        community.map((item, i) => (
          <a
            href={item.href}
            target="_blank"
            rel="noreferrer noopener"
            class="card card-hover group flex items-center gap-3 px-4 py-3.5"
            data-reveal
            style={`--reveal-delay:${(i % 3) * 60}ms`}
          >
            <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-ink-850 text-ink-400 ring-1 ring-ink-700 transition group-hover:text-brand-300">
              <Icon name={item.icon} class="size-4" />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm text-ink-100">{item.label}</span>
              <span class="block truncate text-xs text-ink-500">{item.hint}</span>
            </span>
            <Icon name="arrow" class="size-4 shrink-0 text-ink-600 transition group-hover:text-brand-400" />
          </a>
        ))
      }
    </div>
  </div>
</Section>
