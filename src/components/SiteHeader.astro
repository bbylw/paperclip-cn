---
import { links, navItems } from '../data/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-colors duration-300"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <a
      href="#top"
      class="group flex items-center gap-2.5"
      aria-label="Paperclip 中文社区翻译站 · 首页"
    >
      <span
        class="grid size-8 place-items-center rounded-lg bg-ink-850 ring-1 ring-ink-700 transition-colors group-hover:ring-brand-500/60"
      >
        <Logo class="size-5" />
      </span>
      <span class="text-[15px] font-semibold tracking-tight text-ink-100">Paperclip</span>
      <span class="chip hidden sm:inline-flex">非官方社区翻译</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href.slice(1)}
            aria-current="false"
            class="rounded-lg px-3 py-2 text-sm text-ink-300 transition-colors hover:bg-ink-850 hover:text-ink-100 aria-[current=location]:bg-ink-850 aria-[current=location]:text-ink-100"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={links.github}
        target="_blank"
        rel="noreferrer noopener"
        class="hidden min-h-9 items-center gap-2 rounded-lg border border-ink-600 px-3 text-sm text-ink-200 transition-colors hover:border-ink-500 hover:bg-ink-850 sm:inline-flex"
      >
        <Icon name="star" class="size-4 text-ink-400" />
        <span>GitHub</span>
      </a>
      <a href="#quickstart" class="btn btn-primary !px-3.5 !py-2">
        快速开始
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-lg border border-ink-600 text-ink-200 transition-colors hover:bg-ink-850 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开菜单"
      >
        <Icon name="menu" class="size-5" />
        <Icon name="close" class="hidden size-5" />
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    class="border-t border-ink-800 bg-ink-950/95 backdrop-blur md:hidden"
  >
    <nav class="shell flex flex-col gap-1 py-4" aria-label="移动端导航">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link={item.href.slice(1)}
            class="rounded-lg px-2 py-3 text-sm text-ink-200 transition-colors hover:bg-ink-850 aria-[current=location]:bg-ink-850 aria-[current=location]:text-ink-100"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={links.github}
        target="_blank"
        rel="noreferrer noopener"
        class="btn btn-ghost mt-2 w-full"
      >
        在 GitHub 上查看
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 12);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && mobileNav) {
    const [openIcon, closeIcon] = Array.from(toggle.querySelectorAll('svg'));
    const setOpen = (open: boolean) => {
      // 收起/展开由 CSS grid 过渡承担，这里只翻转 .open
      mobileNav.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      openIcon?.classList.toggle('hidden', open);
      closeIcon?.classList.toggle('hidden', !open);
    };
    setOpen(false);
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    mobileNav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)),
    );
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      toggle.focus();
    });
  }

  // 导航滚动高亮：取「顶部已越过阈值线」且位置最靠下的章节。
  // 注意不能依赖 navItems 的顺序 —— 页面上 faq 位于 roadmap 之前，与导航顺序相反。
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = navLinks
    .map((link) => document.getElementById(link.dataset.navLink ?? ''))
    .filter((el): el is HTMLElement => el !== null);

  if (navLinks.length > 0 && sections.length > 0) {
    const THRESHOLD = 96; // 略大于固定头部高度（h-16 = 64px）
    let frame = 0;

    const paint = () => {
      frame = 0;
      let current: string | undefined;
      let deepest = Number.NEGATIVE_INFINITY;

      for (const section of sections) {
        const top = section.getBoundingClientRect().top;
        if (top - THRESHOLD <= 0 && top > deepest) {
          deepest = top;
          current = section.id;
        }
      }

      // 滚到底部时强制高亮位置最靠下的那一节，避免末节太矮永远选不中
      if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 2) {
        let lowest = Number.NEGATIVE_INFINITY;
        for (const section of sections) {
          const top = section.getBoundingClientRect().top;
          if (top > lowest) {
            lowest = top;
            current = section.id;
          }
        }
      }

      for (const link of navLinks) {
        link.setAttribute(
          'aria-current',
          link.dataset.navLink === current ? 'location' : 'false',
        );
      }
    };

    const schedule = () => {
      if (frame) return;
      frame = requestAnimationFrame(paint);
    };

    paint();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
  }
</script>
