---
import { faqs } from '../data/faq';
import Icon from './Icon.astro';

/**
 * 原生 <details>/<summary> 手风琴 —— 零 JavaScript。
 *
 * 为什么不用框架组件：折叠态的面板在无 JS 时高度为 0 且点击无响应，
 * 5 条 FAQ 里有 4 条将永久不可读。原生 details 默认可展开，
 * 配合 name 属性还能获得浏览器内建的互斥行为。
 */
---

<div class="grid gap-3">
  {
    faqs.map((item, index) => (
      <details class="faq-item card overflow-hidden" name="faq" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-sm text-ink-100 transition hover:text-white sm:px-6 sm:text-base">
          <span class="font-medium">{item.question}</span>
          <span class="faq-marker" aria-hidden="true">
            <Icon name="chevron" class="size-3.5" />
          </span>
        </summary>
        <div class="faq-body">
          {
            /* 答案可以是单段，也可以是多点列表。长答案拆成点，
               避免 120 字一整段在 1216px 宽下排成 3 行 50 字长行。 */
            Array.isArray(item.answer) ? (
              <ul class="space-y-2 px-5 pb-5 sm:px-6">
                {item.answer.map((point) => (
                  <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-400 sm:text-[15px]">
                    <span class="mt-[0.65em] size-1 shrink-0 rounded-full bg-ink-600" aria-hidden="true" />
                    {point}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="max-w-3xl px-5 pb-5 text-sm leading-relaxed text-ink-400 sm:px-6 sm:text-[15px]">
                {item.answer}
              </p>
            )
          }
        </div>
      </details>
    ))
  }
</div>
