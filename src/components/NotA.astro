---
import Section from './Section.astro';
import { notAPillar } from '../data/problems';
---

<Section
  id="boundaries"
  eyebrow="BOUNDARIES"
  title="Paperclip 不是什么"
  lead="把边界说清楚，比把功能说漂亮更有用。"
>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {
      notAPillar.map((item, i) => (
        <article
          class="card p-5 transition hover:border-ink-600"
          data-reveal
          style={`--reveal-delay:${(i % 3) * 70}ms`}
        >
          <h3 class="text-base font-medium text-ink-400 line-through decoration-ink-600 decoration-1">
            {item.title}
          </h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-400">{item.detail}</p>
        </article>
      ))
    }
  </div>
</Section>
