---
import { links, navItems, site, upstream } from '../data/site';
import Logo from './Logo.astro';

const community = [
  { label: 'Discord', href: links.discord, hint: '加入社区' },
  { label: 'Twitter / X', href: links.twitter, hint: '关注更新与公告' },
  { label: 'GitHub Issues', href: links.issues, hint: '缺陷与功能请求' },
  { label: 'GitHub Discussions', href: links.discussions, hint: '想法与 RFC' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800 bg-ink-900/40">
  <div class="shell py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="grid size-8 place-items-center rounded-lg bg-ink-850 ring-1 ring-ink-700">
            <Logo class="size-5" />
          </span>
          <span class="text-base font-semibold text-ink-100">{site.name}</span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-400">
          开源的 AI 智能体团队协作编排工具。管理的是业务目标，而不是 pull request。
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="chip">MIT License</span>
          <span class="chip">自托管优先</span>
          <span class="chip">一次部署，多家公司</span>
        </div>
      </div>

      <nav aria-label="页脚导航">
        <h2 class="text-sm font-medium text-ink-200">页面导航</h2>
        <ul class="mt-3 space-y-1 text-sm text-ink-400">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-block py-1 transition hover:text-brand-300"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="社区链接">
        <h2 class="text-sm font-medium text-ink-200">社区</h2>
        <ul class="mt-3 space-y-1 text-sm text-ink-400">
          {
            community.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="group inline-flex min-h-6 items-baseline gap-2 py-1 transition hover:text-brand-300"
                >
                  {item.label}
                  <span class="text-xs text-ink-600 transition group-hover:text-ink-500">
                    {item.hint}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="mt-10 rounded-xl border border-ink-800 bg-ink-950/60 p-5">
      <h2 class="text-sm font-medium text-ink-200">非官方声明</h2>
      <p class="mt-2 text-xs leading-relaxed text-ink-500">
        本站是 Paperclip 的<strong class="text-ink-300">非官方社区中文翻译站</strong>，与
        <a
          href={upstream.website}
          target="_blank"
          rel="noreferrer noopener"
          class="text-ink-300 underline decoration-ink-600 underline-offset-4 transition hover:text-brand-300"
          >{upstream.name}</a
        > 无隶属关系。Paperclip 的名称、图形商标与官方站点内容归其所有者所有；本站代码以
        <a
          href={links.license}
          target="_blank"
          rel="noreferrer noopener"
          class="text-ink-300 underline decoration-ink-600 underline-offset-4 transition hover:text-brand-300"
          >MIT 协议</a
        > 发布，但该协议不授予任何商标许可。内容如有出入，以
        <a
          href={links.github}
          target="_blank"
          rel="noreferrer noopener"
          class="text-ink-300 underline decoration-ink-600 underline-offset-4 transition hover:text-brand-300"
          >官方仓库</a
        > 为准。
      </p>
    </div>

    <div
      class="mt-10 flex flex-col gap-4 border-t border-ink-800 pt-8 text-sm text-ink-500 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        翻译与站点代码 © {year} Paperclip 中文社区翻译站贡献者 · MIT
      </p>
      <p class="text-ink-600">
        为想把事做成、而不是想盯着智能体的人而打造。
      </p>
    </div>
  </div>
</footer>
