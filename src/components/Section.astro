---
/**
 * 区块外壳。
 *
 * eyebrow 使用约定（全站最多 5 处，其余区块只靠标题定位）：
 *   Hero · FOUR PILLARS · UNDER THE HOOD · QUICKSTART · 非官方声明
 * 14 个区块全部挂 eyebrow 会变成模板噪音，读者不再把它当分类信号。
 */
interface Props {
  id: string;
  title: string;
  /** 小标签分类。仅关键区块使用。 */
  eyebrow?: string;
  lead?: string;
  class?: string;
}

const { id, title, eyebrow, lead, class: className = '' } = Astro.props;
---

<section id={id} class:list={['scroll-mt-24 py-16 sm:py-24', className]}>
  <div class="shell">
    <header class="max-w-2xl" data-reveal>
      {
        eyebrow && (
          <p class="eyebrow mb-4 inline-block">
            {eyebrow}
          </p>
        )
      }
      <h2 class="text-3xl leading-[1.15] font-semibold tracking-tight text-balance text-ink-100 sm:text-4xl">
        {title}
      </h2>
      {
        lead && (
          <p class="mt-4 text-base leading-relaxed text-pretty text-ink-300 sm:text-lg">
            {lead}
          </p>
        )
      }
    </header>
    <div class="mt-10 sm:mt-14">
      <slot />
    </div>
  </div>
</section>
