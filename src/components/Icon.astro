---
/** 轻量内联图标集（24×24 线性图标，颜色继承 currentColor） */
export type IconName =
  | 'plug'
  | 'target'
  | 'heart'
  | 'coin'
  | 'building'
  | 'ticket'
  | 'shield'
  | 'org'
  | 'mobile'
  | 'check'
  | 'x'
  | 'chevron'
  | 'menu'
  | 'close'
  | 'arrow'
  | 'star'
  | 'bolt'
  | 'book'
  | 'terminal'
  | 'clock';

const icons: Record<IconName, string> = {
  plug: '<path d="M9 3v6M15 3v6"/><path d="M6 9h12v2.5A6 6 0 0 1 12 17.5 6 6 0 0 1 6 11.5V9Z"/><path d="M12 17.5V21"/>',
  target:
    '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  heart:
    '<path d="M12 20.5S3.5 15.8 3.5 9.9A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 8.5 2.3c0 5.9-8.5 10.6-8.5 10.6Z"/><path d="M5.5 12.5h3l1.5-2.5 2 5 1.5-2.5h4.9"/>',
  coin:
    '<path d="M12 3.5c4.1 0 7.5 1.2 7.5 2.8S16.1 9 12 9 4.5 7.9 4.5 6.3 7.9 3.5 12 3.5Z"/><path d="M4.5 6.3v11.4c0 1.6 3.4 2.8 7.5 2.8s7.5-1.2 7.5-2.8V6.3"/><path d="M4.5 12c0 1.6 3.4 2.8 7.5 2.8s7.5-1.2 7.5-2.8"/>',
  building:
    '<path d="M4 21V5.5A2.5 2.5 0 0 1 6.5 3H13a2.5 2.5 0 0 1 2.5 2.5V21"/><path d="M15.5 10H19a2 2 0 0 1 2 2v9"/><path d="M2.5 21h19"/><path d="M8 7.5h3M8 11.5h3M8 15.5h3"/>',
  ticket:
    '<path d="M3.5 9.5A2 2 0 0 1 5.5 7.5h13a2 2 0 0 1 2 2v1.2a2.3 2.3 0 0 0 0 4.6v1.2a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2v-1.2a2.3 2.3 0 0 0 0-4.6Z"/><path d="M14.5 8.5v1.5m0 2.5v1.5m0 2.5v-.5"/>',
  shield:
    '<path d="M12 3.2 19 6v5.9c0 4.2-2.9 7.9-7 9-4.1-1.1-7-4.8-7-9V6l7-2.8Z"/><path d="m9 12 2.2 2.2L15.5 10"/>',
  org: '<circle cx="12" cy="4.5" r="2"/><circle cx="6" cy="19.5" r="2"/><circle cx="18" cy="19.5" r="2"/><path d="M12 6.5V10M6 19.5V14a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v5.5M6 10h12"/>',
  mobile: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  x: '<path d="m6 6 12 12M18 6 6 18"/>',
  chevron: '<path d="m6 9.5 6 6 6-6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  arrow: '<path d="M4.5 12h15m-6-7 7 7-7 7"/>',
  star: '<path d="m12 3.6 2.6 5.4 5.9.8-4.3 4.1 1 5.9-5.2-2.8-5.2 2.8 1-5.9L3.5 9.8l5.9-.8L12 3.6Z"/>',
  bolt: '<path d="M13.2 2.5 4.5 13.5H11l-.7 8 8.7-11H12l1.2-8Z"/>',
  book: '<path d="M4 5.2A2.2 2.2 0 0 1 6.2 3H20v15.5H6.2A2.2 2.2 0 0 0 4 20.7Z"/><path d="M4 18.5A2.2 2.2 0 0 1 6.2 16.3H20"/>',
  terminal: '<rect x="2.5" y="4" width="19" height="16" rx="2.5"/><path d="m7 10 2.5 2.5L7 15M12.5 15.5h4.5"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
};

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className = 'size-5', size = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={icons[name]}
/>
