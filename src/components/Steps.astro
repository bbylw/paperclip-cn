---
import Section from './Section.astro';
import { steps } from '../data/steps';
import Icon from './Icon.astro';
---

<Section
  id="how-it-works"
  title="三步，把一支 AI 团队跑起来"
  lead="它看起来像个任务管理器，用起来也像——但你管的是一整个组织。"
>
  <ol class="grid gap-4 md:grid-cols-3">
    {
      steps.map((step, i) => (
        <li
          class="card card-hover group relative flex flex-col overflow-hidden p-6"
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
        >
          <div class="flex items-center justify-between">
            {/* 序号从 1.19:1 提到 3.1:1，同时用等宽 + 表格数字对齐 */}
            <span class="font-mono text-2xl leading-none font-medium text-ink-500 tabular-nums">
              {step.index}
            </span>
            <Icon name="arrow" class="size-4 text-ink-600" />
          </div>
          <h3 class="mt-6 text-lg font-medium text-ink-100">{step.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-400">{step.detail}</p>
        </li>
      ))
    }
  </ol>
</Section>
