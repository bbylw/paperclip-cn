---
import Section from './Section.astro';
import { steps } from '../data/steps';
import Icon from './Icon.astro';
---

<Section
  id="how-it-works"
  eyebrow="HOW IT WORKS"
  title="三步，把一支 AI 团队跑起来"
  lead="它看起来像个任务管理器，用起来也像——但你管的是一整个组织。"
>
  <ol class="grid gap-4 md:grid-cols-3">
    {
      steps.map((step, i) => (
        <li
          class="card card-hover relative overflow-hidden p-6"
          data-reveal
          style={`--reveal-delay:${i * 90}ms`}
        >
          <div class="flex items-baseline justify-between">
            <span class="font-mono text-3xl font-medium text-ink-700 transition group-hover:text-ink-600">
              {step.index}
            </span>
            <Icon name="arrow" class="size-4 text-ink-600" />
          </div>
          <h3 class="mt-6 text-lg font-medium text-ink-100">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-400">{step.detail}</p>
          <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-brand-500/40 to-transparent" />
        </li>
      ))
    }
  </ol>
</Section>
