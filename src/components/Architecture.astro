---
import Section from './Section.astro';
import ServerDiagram from './ServerDiagram.astro';
import { subsystems } from '../data/architecture';
---

{/*
 * 原来 12 个子系统在图里列一遍（中英对照），紧接着 12 张卡片再用中文列一遍 + 3 行说明。
 * 同一批 12 项在 200px 内出现两次，整块约 1800px、24 行连续灰字、零图形。
 *
 * 现在图负责「有什么」（12 个编号 + 英文名），详情只给真正需要解释的 6 项，
 * 并把相关的两项配对：治理+审计、预算+成本、活动+事件、身份+访问、
 * 工作区+运行时、组织+智能体。
 */}
<Section
  id="architecture"
  eyebrow="UNDER THE HOOD"
  title="底层架构"
  lead="Paperclip 是一套完整的控制平面，而非简单的封装。在你自己动手造这些之前，要知道它已经存在了。"
>
  <ServerDiagram />

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {
      subsystems.map((item, i) => (
        <article
          class="card card-hover p-5"
          data-reveal
          style={`--reveal-delay:${(i % 2) * 60}ms`}
        >
          <div class="flex items-center gap-3">
            <span class="ordinal">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="text-base font-medium text-ink-100">{item.title}</h3>
          </div>
          <p class="mt-2.5 pl-[2.6rem] text-sm leading-relaxed text-ink-400">{item.detail}</p>
        </article>
      ))
    }
  </div>
</Section>
