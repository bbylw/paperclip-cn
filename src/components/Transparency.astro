---
import Section from './Section.astro';
import { telemetryOptOut } from '../data/telemetry';
import { links } from '../data/site';
import Icon from './Icon.astro';

const envVars = [
  'OTEL_EXPORTER_OTLP_ENDPOINT',
  'OTEL_EXPORTER_OTLP_PROTOCOL',
  'SENTRY_DSN_FRONTEND',
  'SENTRY_DSN_BACKEND',
];
---

<Section
  id="transparency"
  title="可观测性与遥测"
  lead="追踪能力按需开启，遥测可用任何一种方式一键关闭。"
>
  <div class="grid gap-4 lg:grid-cols-2">
    <article class="card flex flex-col p-6" data-reveal>
      <div class="flex items-center gap-2.5">
        <span
          class="grid size-8 place-items-center rounded-lg bg-sky-400/12 text-sky-400 ring-1 ring-sky-400/30"
        >
          <Icon name="bolt" class="size-4" />
        </span>
        <h3 class="text-base font-medium text-ink-100">可观测性</h3>
        <span class="chip">可选</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-ink-400">
        内置可选的 OpenTelemetry 服务端自动埋点（仅追踪）。设置
        <code class="font-mono text-ink-200">OTEL_EXPORTER_OTLP_ENDPOINT</code>
        后启用，并通过标准的
        <code class="font-mono text-ink-200">OTEL_EXPORTER_OTLP_PROTOCOL</code>
        支持 grpc、http/protobuf 与 http/json。SDK、自动埋点与导出器包都是 optional peer
        dependencies——只有需要追踪时才安装。
      </p>
      <p class="mt-3 text-sm leading-relaxed text-ink-400">
        Sentry 错误监控同样可选，覆盖服务端与浏览器：设置
        <code class="font-mono text-ink-200">SENTRY_DSN_FRONTEND</code> 与
        <code class="font-mono text-ink-200">SENTRY_DSN_BACKEND</code> 即可启用。
      </p>
      <a
        href={links.observability}
        target="_blank"
        rel="noreferrer noopener"
        class="link mt-4 inline-block self-start text-xs"
        >安装命令与环境变量参考 →</a
      >
    </article>

    <article class="card flex flex-col p-6" data-reveal style="--reveal-delay:80ms">
      <div class="flex flex-wrap items-center gap-2.5">
        <span
          class="grid size-8 place-items-center rounded-lg bg-mint-500/12 text-mint-300 ring-1 ring-mint-500/30"
        >
          <Icon name="shield" class="size-4" />
        </span>
        <h3 class="text-base font-medium text-ink-100">遥测</h3>
        {/* 隐私相关信息必须能被扫到，不能只藏在标题的括号里 */}
        <span
          class="rounded-full bg-brand-500/12 px-2 py-0.5 text-xs text-brand-300 ring-1 ring-brand-500/30"
        >
          默认开启
        </span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-ink-400">
        Paperclip 收集匿名的使用遥测数据。绝不收集个人信息、事项内容、提示词、文件路径或密钥；私有仓库的引用在发送前会用每个安装实例独立的盐值做哈希。
      </p>
      <dl class="mt-4 grid gap-px overflow-hidden rounded-xl border border-ink-800 bg-ink-800 sm:grid-cols-2">
        {
          telemetryOptOut.map((row) => (
            <div class="bg-ink-900 px-4 py-3">
              <dt class="text-xs text-ink-400">{row.method}</dt>
              <dd class="mt-1 font-mono text-xs leading-relaxed text-ink-200">{row.how}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 text-xs leading-relaxed text-ink-400">
        改动已发出遥测事件的贡献者，请遵循
        <a href={links.telemetryContract} target="_blank" rel="noreferrer noopener" class="link"
          >遥测数据契约</a
        >；建议新增的第一方事件请遵循
        <a href={links.telemetryWorkflow} target="_blank" rel="noreferrer noopener" class="link"
          >遥测工作流</a
        >。
      </p>
    </article>
  </div>

  {/* 环境变量集中列出：正文里 4 处 code 样式分散在两段话中，扫读时找不到 */}
  <div class="mt-4 flex flex-wrap items-center gap-2" data-reveal>
    <span class="text-xs text-ink-400">相关环境变量：</span>
    {
      envVars.map((name) => (
        <code class="rounded-lg bg-ink-900 px-2 py-1 font-mono text-xs text-ink-200 ring-1 ring-ink-700">
          {name}
        </code>
      ))
    }
  </div>
</Section>
