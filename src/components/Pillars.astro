---
import Section from './Section.astro';
import { pillars } from '../data/pillars';
import type { Pillar } from '../data/pillars';
import Icon from './Icon.astro';

/*
 * 强调色只出现在图标底色与 hover 描边上，不再染正文。
 * 之前四张卡的副标题分别是橙/蓝/紫/绿，与紧邻的 Features（全部橙色）
 * 互相推翻规则，读者无法把同层级元素读成同一类信息。
 */
const accents: Record<Pillar['accent'], { chip: string; ring: string; glyph: string }> = {
  brand: { chip: 'bg-brand-500/12 text-brand-300', ring: 'group-hover:border-brand-500/50', glyph: 'text-brand-400' },
  mint: { chip: 'bg-mint-500/12 text-mint-300', ring: 'group-hover:border-mint-500/50', glyph: 'text-mint-400' },
  sky: { chip: 'bg-sky-400/12 text-sky-400', ring: 'group-hover:border-sky-400/50', glyph: 'text-sky-400' },
  violet: { chip: 'bg-violet-400/12 text-violet-400', ring: 'group-hover:border-violet-400/50', glyph: 'text-violet-400' },
};

const pillarIcons = ['ticket', 'org', 'book', 'terminal'] as const;
---

<Section
  id="pillars"
  eyebrow="FOUR PILLARS"
  title="四大支柱"
  lead="一个由 AI 智能体组成的组织要真正产出价值，有四件事必须到位：任务、组织、训练与基础设施。Paperclip 正是围绕这四根支柱构建的。"
>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      pillars.map((pillar, i) => (
        <article
          class:list={['card card-hover group flex flex-col p-6', accents[pillar.accent].ring]}
          data-reveal
          style={`--reveal-delay:${(i % 2) * 80}ms`}
        >
          <div class="flex items-center justify-between gap-4">
            <span
              class:list={[
                'grid size-10 shrink-0 place-items-center rounded-xl',
                accents[pillar.accent].chip,
              ]}
            >
              <Icon name={pillarIcons[i]} class="size-5" />
            </span>
            <span class="chip shrink-0">{pillar.audience}</span>
          </div>
          <h3 class="mt-5 text-lg font-medium text-ink-100">{pillar.name}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-ink-300">{pillar.tagline}</p>
          <ul class="mt-5 space-y-2.5 border-t border-ink-800 pt-4">
            {pillar.covers.map((item) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-ink-400">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-ink-600" />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
