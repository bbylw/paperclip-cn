---
import Section from './Section.astro';
import { pillars } from '../data/pillars';
import type { Pillar } from '../data/pillars';
import Icon from './Icon.astro';

const accents: Record<Pillar['accent'], { text: string; ring: string; icon: string }> = {
  brand: {
    text: 'text-brand-400',
    ring: 'group-hover:border-brand-500/50',
    icon: 'bg-brand-500/12 text-brand-300',
  },
  mint: {
    text: 'text-mint-400',
    ring: 'group-hover:border-mint-500/50',
    icon: 'bg-mint-500/12 text-mint-300',
  },
  sky: {
    text: 'text-sky-400',
    ring: 'group-hover:border-sky-400/50',
    icon: 'bg-sky-400/12 text-sky-400',
  },
  violet: {
    text: 'text-violet-400',
    ring: 'group-hover:border-violet-400/50',
    icon: 'bg-violet-400/12 text-violet-400',
  },
};

const pillarIcons = ['ticket', 'org', 'book', 'terminal'] as const;
---

<Section
  id="pillars"
  eyebrow="FOUR PILLARS"
  title="四大支柱"
  lead="一个由 AI 智能体组成的组织要真正产出价值，有四件事必须到位：任务、组织、训练与基础设施。Paperclip 正是围绕这四根支柱构建的。"
>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      pillars.map((pillar, i) => (
        <article
          class:list={['card card-hover group p-6', accents[pillar.accent].ring]}
          data-reveal
          style={`--reveal-delay:${(i % 2) * 80}ms`}
        >
          <div class="flex items-start justify-between gap-4">
            <span
              class:list={[
                'grid size-10 shrink-0 place-items-center rounded-xl',
                accents[pillar.accent].icon,
              ]}
            >
              <Icon name={pillarIcons[i]} class="size-5" />
            </span>
            <span class="chip shrink-0">面向{pillar.audience}</span>
          </div>
          <h3 class="mt-5 text-lg font-medium text-ink-100">{pillar.name}</h3>
          <p class:list={['mt-1.5 text-sm', accents[pillar.accent].text]}>{pillar.tagline}</p>
          <ul class="mt-4 space-y-2 border-t border-ink-800 pt-4">
            {pillar.covers.map((item) => (
              <li class="flex items-start gap-2 text-sm text-ink-400">
                <span class="mt-2 size-1 shrink-0 rounded-full bg-ink-600" />
                {item}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
