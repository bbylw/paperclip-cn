---
import Section from './Section.astro';
import { problems, differentiators } from '../data/problems';
import Icon from './Icon.astro';
---

<Section
  id="problems"
  eyebrow="BEFORE / AFTER"
  title="Paperclip 解决了哪些问题"
  lead="左边是你现在的日常，右边是接入 Paperclip 之后的样子。"
>
  <div class="overflow-hidden rounded-2xl border border-ink-800">
    <div
      class="hidden grid-cols-2 gap-px bg-ink-800 text-xs tracking-[0.2em] text-ink-500 uppercase md:grid"
    >
      <p class="bg-ink-900 px-6 py-3">没有 Paperclip</p>
      <p class="bg-ink-900 px-6 py-3">用了 Paperclip</p>
    </div>
    <ul class="grid gap-px bg-ink-800 md:grid-cols-2">
      {
        problems.map((pair, i) => (
          <li class="contents" data-reveal style={`--reveal-delay:${(i % 2) * 60}ms`}>
            <div class="flex gap-3 bg-ink-900 p-5 sm:p-6">
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-ink-800 text-ink-500">
                <Icon name="x" class="size-3" size={12} />
              </span>
              <p class="text-sm leading-relaxed text-ink-500 line-through decoration-ink-700">
                {pair.before}
              </p>
            </div>
            <div class="flex gap-3 bg-ink-900 p-5 sm:p-6">
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-mint-500/15 text-mint-400">
                <Icon name="check" class="size-3" size={12} />
              </span>
              <p class="text-sm leading-relaxed text-ink-200">{pair.after}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<Section
  id="differentiators"
  eyebrow="CRAFTED DETAILS"
  title="Paperclip 特别之处"
  lead="Paperclip 把那些棘手的编排细节都做对了。"
>
  <ul class="grid gap-px overflow-hidden rounded-2xl border border-ink-800 bg-ink-950 md:grid-cols-2">
    {
      differentiators.map((item, i) => (
        <li
          class="group bg-ink-900 p-6 transition hover:bg-ink-850"
          data-reveal
          style={`--reveal-delay:${(i % 2) * 60}ms`}
        >
          <div class="flex items-center gap-2.5">
            <span class="font-mono text-[11px] text-ink-600 group-hover:text-brand-400">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="text-base font-medium text-ink-100">{item.title}</h3>
          </div>
          <p class="mt-3 pl-8 text-sm leading-relaxed text-ink-400">{item.detail}</p>
        </li>
      ))
    }
  </ul>
</Section>
