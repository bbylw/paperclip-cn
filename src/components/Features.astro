---
import Section from './Section.astro';
import { features } from '../data/pillars';
import { links } from '../data/site';
import Icon from './Icon.astro';
---

{/*
 * lead 不再复述下面 9 张卡的标题——那句话在 400px 内把 9 个标题又打了一遍，
 * 零信息量。脚注从 11px 提到 12px/4.9:1，并收窄行宽避免横跨整屏。
 */}
<Section
  id="features"
  title="功能特性"
  lead="从接入智能体到成本管控，Paperclip 把经营一支 AI 团队需要的九件事收进一个控制平面。"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature, i) => (
        <article
          class="card card-hover group flex flex-col p-6"
          data-reveal
          style={`--reveal-delay:${(i % 3) * 80}ms`}
        >
          <span class="grid size-10 place-items-center rounded-xl bg-ink-850 text-brand-300 ring-1 ring-ink-700 transition group-hover:ring-brand-500/50">
            <Icon name={feature.icon} class="size-5" />
          </span>
          <h3 class="mt-5 text-base font-medium text-ink-100">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-400">{feature.detail}</p>
        </article>
      ))
    }
  </div>

  <aside class="mt-6 max-w-3xl border-l-2 border-ink-700 pl-4" data-reveal>
    <p class="text-xs leading-relaxed text-ink-400">
      <strong class="font-medium text-ink-200">关于工单系统：</strong>
      上面的「事项与审计」指的是已交付的事项、评论、附件与审计日志能力。完整的工单系统（含 Asana、Linear、Jira
      作为接入点）仍在<a href={links.roadmap} target="_blank" rel="noreferrer noopener" class="link"
        >路线图</a
      >中。
    </p>
  </aside>
</Section>
