---
import Section from './Section.astro';
import { features } from '../data/pillars';
import { links } from '../data/site';
import Icon from './Icon.astro';
---

<Section
  id="features"
  eyebrow="FEATURES"
  title="功能特性"
  lead="自带你的智能体、目标对齐、心跳机制、成本管控、多组织隔离、事项与审计、治理、组织架构图与移动端。"
>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((feature, i) => (
        <article
          class="card card-hover group flex flex-col p-6"
          data-reveal
          style={`--reveal-delay:${(i % 3) * 80}ms`}
        >
          <span class="grid size-10 place-items-center rounded-xl bg-ink-850 text-brand-300 ring-1 ring-ink-700 transition group-hover:ring-brand-500/50">
            <Icon name={feature.icon} class="size-5" />
          </span>
          <h3 class="mt-5 text-base font-medium text-ink-100">{feature.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-ink-400">{feature.detail}</p>
        </article>
      ))
    }
  </div>

  <p class="mt-6 text-xs leading-relaxed text-ink-500">
    注：完整的<strong class="text-ink-300">工单系统</strong>（含 Asana / Linear / Jira 作为接入点）仍在
    <a
      href={links.roadmap}
      target="_blank"
      rel="noreferrer noopener"
      class="text-ink-300 underline decoration-ink-600 underline-offset-4 transition hover:text-brand-300"
      >路线图</a
    >
    中。上面的「事项与审计」指的是已交付的事项、评论、附件与审计日志能力。
  </p>
</Section>
