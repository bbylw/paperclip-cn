---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { links, navItems } from '../data/site';
---

<Base
  title="页面不存在 · Paperclip 中文社区翻译站"
  description="你访问的页面不存在或已被移动。可以从下面的入口继续，或回到首页。"
  noindex
>
  <section class="relative overflow-hidden py-28 sm:py-40">
    <div class="shell">
      <div class="mx-auto max-w-xl text-center" data-reveal>
        <p class="font-mono text-xs tracking-[0.3em] text-brand-400 uppercase">404</p>
        <h1 class="mt-4 text-3xl font-semibold tracking-tight text-balance text-ink-100 sm:text-4xl">
          这个页面没有对应的智能体
        </h1>
        <p class="mt-4 text-base leading-relaxed text-pretty text-ink-300">
          地址可能拼错了，或者页面已经被移动。你可以从下面的章节继续，或者回到首页。
        </p>
      </div>

      <div class="mx-auto mt-10 flex max-w-xl flex-wrap items-center justify-center gap-3" data-reveal>
        <a
          href="#top"
          class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-5 py-3 text-sm font-medium text-ink-950 transition hover:bg-brand-400"
        >
          回到首页
          <Icon name="arrow" class="size-4" />
        </a>
        <a
          href={links.github}
          target="_blank"
          rel="noreferrer noopener"
          class="inline-flex items-center gap-2 rounded-xl border border-ink-700 px-5 py-3 text-sm text-ink-200 transition hover:border-ink-600 hover:bg-ink-850"
        >
          <Icon name="star" class="size-4" />
          在 GitHub 上提 issue
        </a>
      </div>

      <nav
        aria-label="页面导航"
        class="mx-auto mt-12 max-w-2xl border-t border-ink-800 pt-8"
        data-reveal
      >
        <ul class="flex flex-wrap items-center justify-center gap-2">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="chip transition hover:border-ink-600 hover:text-ink-100"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>
