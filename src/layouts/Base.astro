---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import { site, upstream } from '../data/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** 是否输出 noindex（404 等页面用） */
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', site.url).href;
const ogImage = new URL(site.ogImage, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'Paperclip',
  alternateName: 'Paperclip 中文社区文档站',
  description: site.description,
  url: site.url,
  codeRepository: upstream.repo,
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Organization', name: upstream.name, url: upstream.website },
  inLanguage: 'zh-CN',
  keywords: ['AI 智能体', '智能体编排', '多智能体协作', '组织架构图', '预算管控', '治理'],
};
---

<!doctype html>
<html lang="zh-CN" class="scheme-dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#08080c" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content="Paperclip 中文社区翻译站（非官方）" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Paperclip 中文社区翻译站" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="628" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only rounded-lg bg-brand-500 px-4 py-2 text-sm text-ink-950 focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
    >
      跳到主要内容
    </a>

    <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
      <div class="grid-bg absolute inset-0 opacity-70"></div>
      <div
        class="absolute -top-40 left-1/2 h-80 w-[52rem] -translate-x-1/2 rounded-full bg-brand-500/10 blur-3xl"
      >
      </div>
    </div>

    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // 滚动进场动画。
      // 用 rAF 节流的位置扫描，而不是 IntersectionObserver：
      // 快速滚动或锚点跳转时，IO 可能整个跳过某个元素（两帧之间从视口下方越到上方），
      // 那样它会永远停在 opacity: 0 —— 内容就这样消失了。
      const pending = new Set<HTMLElement>(
        Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]')),
      );

      const reveal = () => {
        if (pending.size === 0) return;
        const limit = window.innerHeight * 0.92;
        for (const el of pending) {
          if (el.getBoundingClientRect().top < limit) {
            el.classList.add('is-in');
            pending.delete(el);
          }
        }
      };

      if (pending.size > 0) {
        let frame = 0;
        const schedule = () => {
          if (frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            reveal();
          });
        };
        reveal();
        window.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule, { passive: true });
      }
    </script>
  </body>
</html>
